{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://soustack.org/schemas/recipe/modules/media/1.schema.json",
  "title": "Soustack Media Module v1",
  "description": "Optional media collections for recipes.",
  "type": "object",
  "properties": {
    "media": {
      "type": "object",
      "properties": {
        "images": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "minItems": 1
        },
        "videos": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    }
  }
}
